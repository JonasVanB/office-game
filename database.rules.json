{
  "rules": {
    "profiles": {
      ".read": true,
      "$oid": {
        ".write": "$oid.length <= 64",
        ".validate": "newData.hasChildren(['name', 'avatar']) && newData.child('name').isString() && newData.child('name').val().length <= 20"
      }
    },
    "presence": {
      ".read": true,
      "$key": {
        ".write": "$key.length <= 40",
        ".validate": "newData.hasChildren(['x', 'z', 't']) && newData.child('x').isNumber() && newData.child('z').isNumber() && (!newData.child('c').exists() || (newData.child('c').isString() && newData.child('c').val().length <= 120))"
      }
    },
    "postits": {
      ".read": true,
      "$id": {
        ".write": "$id.length <= 64",
        ".validate": "newData.hasChildren(['n', 'h', 'z']) && newData.child('n').isString() && newData.child('n').val().length <= 20 && newData.child('h').isNumber() && newData.child('h').val() >= 2 && newData.child('h').val() <= 3.2 && newData.child('z').isNumber()"
      }
    },
    "boards": {
      ".read": true,
      "$b": {
        ".write": "$b.length <= 3",
        "$s": {
          ".validate": "newData.hasChildren(['c', 'w', 'p']) && newData.child('c').isNumber() && newData.child('w').isNumber() && newData.child('p').isString() && newData.child('p').val().length <= 4000"
        }
      }
    },
    "tiles": {
      ".read": true,
      "$k": {
        ".write": "$k.length <= 8",
        ".validate": "newData.hasChildren(['q', 'n']) && newData.child('q').isString() && newData.child('q').val().length <= 70 && newData.child('n').isString() && newData.child('n').val().length <= 20"
      }
    },
    "doors": {
      ".read": true,
      "$i": {
        ".write": "$i.length <= 3",
        ".validate": "newData.hasChildren(['o']) && newData.child('o').isBoolean()"
      }
    }
  }
}
